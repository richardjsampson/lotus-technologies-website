---
import '../styles/global.css';
import '../styles/capability-illustrations.css';
import '../styles/hero-ecosystem.css';
import '../styles/homepage-cinematic-hero.css';
import '../styles/featured-case-study.css';
import '../styles/case-study-transitions.css';
import '../styles/process-section.css';
import '../styles/process-fixes.css';
import '../styles/our-process-page.css';
import '../styles/process-approval-diagram.css';
import '../styles/process-mobile-diagram.css';
import '../styles/process-diagram-polish.css';
import '../styles/about-silhouette-fixes.css';
import '../styles/about-cinematic-hero.css';
import '../styles/about-hero-background.css';
import '../styles/case-studies-hero-art.css';
import '../styles/trusted-by.css';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';

const {
	title = 'Lotus Technologies',
	description = 'Lotus Technologies — technology solutions for real business problems.',
} = Astro.props;

const bodyClass = `min-h-screen bg-gradient-to-br from-lotus-navy via-lotus-navy to-[#102F63] text-white${Astro.url.pathname === '/' ? ' home-page' : ''}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=3" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
		<title>{title}</title>
		<style is:global>
			body.home-page main > section:nth-child(3) {
				display: none;
			}
		</style>
	</head>

	<body class={bodyClass}>
		<Header />

		<main>
			<slot />
		</main>

		<Footer />
		<script is:inline src="/process-section.js"></script>
		<script is:inline src="/process-approval-diagram.js"></script>
		<script is:inline src="/process-mobile-diagram.js"></script>
		<script is:inline>
			if (window.location.pathname === '/' || window.location.pathname === '') {
				const heroHeading = document.querySelector('main > section:first-child h1');
				if (heroHeading) heroHeading.textContent = 'Solving business problems with technical solutions.';

				const trustedSection = document.querySelector('main > section:nth-child(2)');
				if (trustedSection) {
					const heading = trustedSection.querySelector('.text-center > p');
					if (heading) heading.textContent = 'Trusted By';

					const logoGrid = trustedSection.querySelector('.text-center + div');
					if (logoGrid && !logoGrid.classList.contains('trusted-logo-viewport')) {
						const makeLogo = (src, alt, extraClass) => {
							const item = document.createElement('div');
							item.className = `trusted-logo-item ${extraClass || ''}`.trim();
							const img = document.createElement('img');
							img.src = src;
							img.alt = alt;
							img.loading = 'lazy';
							item.appendChild(img);
							return item;
						};

						const originalItems = Array.from(logoGrid.children);
						for (const item of originalItems) {
							item.className = 'trusted-logo-item';
							const img = item.querySelector('img');
							if (img) img.className = '';
						}

						const berkshire = makeLogo('/clients/berkshire-hathaway.png', 'Berkshire Hathaway HomeServices', 'trusted-logo-item--berkshire');
						const sanDiego = makeLogo('/clients/city-of-san-diego.png', 'The City of San Diego', 'trusted-logo-item--sandiego');
						const orderedItems = [berkshire, sanDiego, ...originalItems];

						const track = document.createElement('div');
						track.className = 'trusted-logo-track';
						for (const item of orderedItems) track.appendChild(item);

						for (const item of orderedItems) {
							const clone = item.cloneNode(true);
							clone.classList.add('trusted-logo-clone');
							clone.setAttribute('aria-hidden', 'true');
							const img = clone.querySelector('img');
							if (img) img.alt = '';
							track.appendChild(clone);
						}

						logoGrid.className = 'trusted-logo-viewport';
						logoGrid.replaceChildren(track);
					}
				}
			}

			if (window.location.pathname === '/about' || window.location.pathname === '/about/') {
				document.querySelector('.about-values-wrap')?.remove();
				const aboutTeamIntro = document.querySelector('.about-team-intro');
				if (aboutTeamIntro) aboutTeamIntro.textContent = 'The Lotus team is comprised of experts specializing in end-to-end Software Development, Security, AI, Infrastructure, Design, Telecommunications, Business Intelligence, Data Architecture, ERP/CRM/SaaS, Hardware, and many other disciplines. We are platform and vendor agnostic, and will work together with you to find the right solution to achieve your goals. Our leadership team includes:';
				const aboutCta = document.querySelector('.about-close a[href="/contact"]');
				if (aboutCta) aboutCta.textContent = 'Get in Touch';
			}
		</script>
	</body>
</html>