---
import '../styles/global.css';
import '../styles/capability-illustrations.css';
import '../styles/hero-ecosystem.css';
import '../styles/homepage-cinematic-hero.css';
import '../styles/featured-case-study.css';
import '../styles/case-study-transitions.css';
import '../styles/process-section.css';
import '../styles/process-fixes.css';
import '../styles/our-process-page.css';
import '../styles/process-approval-diagram.css';
import '../styles/process-mobile-diagram.css';
import '../styles/process-diagram-polish.css';
import '../styles/about-silhouette-fixes.css';
import '../styles/about-cinematic-hero.css';
import '../styles/about-hero-background.css';
import '../styles/case-studies-hero-art.css';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';

const {
	title = 'Lotus Technologies',
	description = 'Lotus Technologies — technology solutions for real business problems.',
} = Astro.props;

const bodyClass = `min-h-screen bg-gradient-to-br from-lotus-navy via-lotus-navy to-[#102F63] text-white${Astro.url.pathname === '/' ? ' home-page' : ''}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=3" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
		<title>{title}</title>
		<style is:global>
			body.home-page main > section:nth-child(3) {
				display: none;
			}
		</style>
	</head>

	<body class={bodyClass}>
		<Header />

		<main>
			<slot />
		</main>

		<Footer />
		<script is:inline src="/process-section.js"></script>
		<script is:inline src="/process-approval-diagram.js"></script>
		<script is:inline src="/process-mobile-diagram.js"></script>
		<script is:inline>
			if (window.location.pathname === '/about' || window.location.pathname === '/about/') {
				document.querySelector('.about-values-wrap')?.remove();
				const aboutTeamIntro = document.querySelector('.about-team-intro');
				if (aboutTeamIntro) aboutTeamIntro.textContent = 'The Lotus team is comprised of experts specializing in end-to-end Software Development, Security, AI, Infrastructure, Design, Telecommunications, Business Intelligence, Data Architecture, ERP/CRM/SaaS, Hardware, and many other disciplines. We are platform and vendor agnostic, and will work together with you to find the right solution to achieve your goals. Our leadership team includes:';
				const aboutCta = document.querySelector('.about-close a[href="/contact"]');
				if (aboutCta) aboutCta.textContent = 'Get in Touch';
			}
		</script>
	</body>
</html>