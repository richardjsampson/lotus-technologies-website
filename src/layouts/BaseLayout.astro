---
import '../styles/global.css';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';

const {
	title = 'Lotus Technologies',
	description = 'Lotus Technologies — technology solutions for real business problems.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="stylesheet" href="/capability-illustrations.css" />
		<title>{title}</title>
	</head>

	<body class="min-h-screen bg-gradient-to-br from-lotus-navy via-lotus-navy to-[#102F63] text-white">
		<Header />

		<main>
			<slot />
		</main>

		<Footer />
	</body>
</html>