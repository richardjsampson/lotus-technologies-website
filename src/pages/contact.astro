---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Contact Us | Lotus Technologies"
	description="Tell Lotus Technologies what you're trying to solve. Start a conversation about your business, technology, integration, software, or operational challenge."
>
	<section class="contact-page">
		<div class="contact-shell">
			<div class="contact-copy">
				<p class="contact-eyebrow">Contact Us</p>
				<h1>Let’s talk about what you’re trying to <span>solve.</span></h1>
				<p class="contact-intro">
					You don’t need a complete technical plan. Tell us the goal, the problem, or what isn’t working — we’ll help determine the right path forward.
				</p>

				<div class="contact-direct" aria-label="Alternate contact information">
					<p>Prefer to reach out directly?</p>
					<a href="mailto:info@lotustechnologies.dev">
						<span>Email</span>
						<strong>info@lotustechnologies.dev</strong>
					</a>
					<a href="tel:+16197585485">
						<span>Phone</span>
						<strong>619.758.5485</strong>
					</a>
				</div>

				<div class="contact-promise">
					<span class="contact-promise-mark">✦</span>
					<p><strong>Start with the business problem.</strong><br />We’ll help translate it into the right technical solution.</p>
				</div>
			</div>

			<div class="contact-form-wrap">
				<div class="contact-form-heading">
					<p>Start the conversation</p>
					<h2>What are you trying to accomplish?</h2>
				</div>

				<form class="contact-form" aria-label="Contact Lotus Technologies" novalidate>
					<div class="contact-field-row">
						<label>
							<span>Name</span>
							<input type="text" name="name" autocomplete="name" maxlength="120" required />
						</label>
						<label>
							<span>Company <em>optional</em></span>
							<input type="text" name="company" autocomplete="organization" maxlength="160" />
						</label>
					</div>

					<label>
						<span>Email</span>
						<input type="email" name="email" autocomplete="email" maxlength="254" required />
					</label>

					<label>
						<span>What are you trying to solve?</span>
						<textarea name="challenge" rows="5" maxlength="5000" required placeholder="A goal, a problem, an existing system that isn’t working the way you need — start wherever makes sense."></textarea>
					</label>

					<div class="contact-turnstile">
						<div class="cf-turnstile" data-sitekey="0x4AAAAAAFJf05M13DLJJtK0" data-theme="dark"></div>
					</div>

					<div class="contact-submit-row">
						<button type="submit">Send inquiry <span aria-hidden="true">→</span></button>
						<p class="contact-form-note">We’ll review your message and get back to you as soon as possible.</p>
					</div>
					<p class="contact-form-status" aria-live="polite"></p>
				</form>
			</div>
		</div>
	</section>

	<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
	<script is:inline>
		const contactForm = document.querySelector('.contact-form');
		const contactStatus = document.querySelector('.contact-form-status');
		const submitButton = contactForm?.querySelector('button[type="submit"]');

		contactForm?.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!contactForm.reportValidity()) return;

			const data = new FormData(contactForm);
			const turnstileToken = String(data.get('cf-turnstile-response') || '').trim();
			if (!turnstileToken) {
				if (contactStatus) {
					contactStatus.textContent = 'Please complete the security check before sending your message.';
					contactStatus.dataset.state = 'error';
				}
				return;
			}

			const payload = {
				name: String(data.get('name') || '').trim(),
				company: String(data.get('company') || '').trim(),
				email: String(data.get('email') || '').trim(),
				challenge: String(data.get('challenge') || '').trim(),
				turnstileToken,
			};

			if (submitButton) {
				submitButton.disabled = true;
				submitButton.dataset.originalText = submitButton.innerHTML;
				submitButton.textContent = 'Sending…';
			}
			if (contactStatus) {
				contactStatus.textContent = 'Sending your inquiry…';
				contactStatus.dataset.state = 'pending';
			}

			try {
				const response = await fetch('/api/contact', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(payload),
				});
				const result = await response.json().catch(() => ({}));
				if (!response.ok) throw new Error(result.error || 'Unable to send your inquiry.');

				contactForm.reset();
				window.turnstile?.reset();
				if (contactStatus) {
					contactStatus.textContent = 'Thanks — your message has been sent. We’ll be in touch soon.';
					contactStatus.dataset.state = 'success';
				}
			} catch (error) {
				window.turnstile?.reset();
				if (contactStatus) {
					contactStatus.textContent = error instanceof Error ? error.message : 'Unable to send your inquiry. Please try again.';
					contactStatus.dataset.state = 'error';
				}
			} finally {
				if (submitButton) {
					submitButton.disabled = false;
					submitButton.innerHTML = submitButton.dataset.originalText || 'Send inquiry <span aria-hidden="true">→</span>';
				}
			}
		});
	</script>
</BaseLayout>

<style>
	.contact-page {
		position: relative;
		overflow: hidden;
		padding: clamp(5.5rem, 8vw, 8rem) 1.5rem clamp(6rem, 8vw, 8rem);
	}
	.contact-page::before {
		content: "";
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 18% 22%, rgba(30, 99, 233, .24), transparent 31%),
			radial-gradient(circle at 82% 68%, rgba(242, 184, 75, .1), transparent 27%);
		pointer-events: none;
	}
	.contact-shell {
		position: relative;
		z-index: 1;
		max-width: 1400px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(500px, .92fr) minmax(600px, 1.08fr);
		gap: clamp(3rem, 5vw, 5.5rem);
		align-items: start;
	}
	.contact-copy,
	.contact-form-wrap { min-width: 0; }
	.contact-eyebrow,
	.contact-form-heading p {
		margin: 0;
		color: #63BEFF;
		font-size: .78rem;
		font-weight: 800;
		letter-spacing: .22em;
		text-transform: uppercase;
	}
	.contact-copy h1 {
		max-width: 10.5ch;
		margin: .9rem 0 0;
		font-size: clamp(3.4rem, 4.6vw, 5.4rem);
		font-weight: 620;
		line-height: .96;
		letter-spacing: -.052em;
		color: #fff;
		overflow-wrap: normal;
		word-break: normal;
	}
	.contact-copy h1 span { color: #F2B84B; }
	.contact-intro {
		max-width: 620px;
		margin: 1.5rem 0 0;
		color: rgba(255,255,255,.68);
		font-size: clamp(1rem, 1.25vw, 1.18rem);
		line-height: 1.68;
	}
	.contact-direct {
		max-width: 620px;
		margin-top: 2rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(255,255,255,.1);
	}
	.contact-direct > p { margin: 0 0 .75rem; color: rgba(255,255,255,.42); font-size: .82rem; }
	.contact-direct a {
		display: grid;
		grid-template-columns: 74px minmax(0, 1fr);
		align-items: baseline;
		gap: .8rem;
		padding: .38rem 0;
		text-decoration: none;
		transition: transform .18s ease;
	}
	.contact-direct a:hover { transform: translateX(4px); }
	.contact-direct span { color: #63BEFF; font-size: .72rem; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
	.contact-direct strong { color: rgba(255,255,255,.88); font-size: 1rem; font-weight: 600; overflow-wrap:anywhere; }
	.contact-promise {
		margin-top: 1.8rem;
		display: flex;
		gap: .9rem;
		align-items: flex-start;
		max-width: 560px;
		color: rgba(255,255,255,.52);
		font-size: .86rem;
		line-height: 1.55;
	}
	.contact-promise-mark { color: #F2B84B; font-size: 1.05rem; line-height: 1.5; }
	.contact-promise p { margin: 0; }
	.contact-promise strong { color: rgba(255,255,255,.84); }

	.contact-form-wrap {
		position: relative;
		width: 100%;
		padding: clamp(1.6rem, 2.5vw, 2.25rem);
		border: 1px solid rgba(111,184,255,.2);
		border-radius: 26px;
		background: linear-gradient(180deg, rgba(17,49,96,.78), rgba(6,22,49,.9));
		box-shadow: 0 34px 90px rgba(0,0,0,.28);
	}
	.contact-form-wrap::before {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: linear-gradient(135deg, rgba(99,190,255,.08), transparent 35%, rgba(242,184,75,.04));
		pointer-events: none;
	}
	.contact-form-heading,
	.contact-form { position: relative; z-index: 1; }
	.contact-form-heading h2 {
		max-width: 16ch;
		margin: .55rem 0 0;
		color: #fff;
		font-size: clamp(1.9rem, 2.6vw, 2.8rem);
		line-height: 1.06;
		letter-spacing: -.035em;
	}
	.contact-form { margin-top: 1.55rem; display: grid; gap: .95rem; }
	.contact-field-row { display: grid; grid-template-columns: 1fr 1fr; gap: .9rem; }
	.contact-form label { display: grid; gap: .42rem; min-width:0; }
	.contact-form label > span { color: rgba(255,255,255,.72); font-size: .78rem; font-weight: 700; }
	.contact-form label em { margin-left: .3rem; color: rgba(255,255,255,.34); font-size: .68rem; font-style: normal; font-weight: 500; }
	.contact-form input,
	.contact-form textarea {
		width: 100%;
		min-width: 0;
		border: 1px solid rgba(255,255,255,.12);
		border-radius: 11px;
		background: rgba(3,16,37,.54);
		color: #fff;
		padding: .82rem .95rem;
		outline: none;
		transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
	}
	.contact-form textarea { min-height: 128px; resize: vertical; line-height: 1.55; }
	.contact-form input:focus,
	.contact-form textarea:focus { border-color: rgba(99,190,255,.7); background: rgba(5,24,53,.75); box-shadow: 0 0 0 3px rgba(99,190,255,.08); }
	.contact-form textarea::placeholder { color: rgba(255,255,255,.28); }
	.contact-turnstile { min-height: 65px; display: flex; align-items: center; }
	.contact-submit-row { display: flex; align-items: center; gap: 1rem; margin-top: .15rem; }
	.contact-form button {
		flex: 0 0 auto;
		display: inline-flex;
		align-items: center;
		gap: .7rem;
		border: 0;
		border-radius: 11px;
		background: #1E63E9;
		color: #fff;
		padding: .85rem 1.15rem;
		font-weight: 800;
		cursor: pointer;
		transition: transform .18s ease, background .18s ease, opacity .18s ease;
	}
	.contact-form button:hover:not(:disabled) { transform: translateY(-2px); background: #2873f0; }
	.contact-form button:disabled { cursor: wait; opacity: .65; }
	.contact-form button span { font-size: 1.15rem; }
	.contact-form-note,
	.contact-form-status { margin: 0; color: rgba(255,255,255,.38); font-size: .74rem; line-height: 1.45; }
	.contact-form-status { color: #8FD4FF; min-height: 1.1em; }
	.contact-form-status[data-state="success"] { color: #8FE4B8; }
	.contact-form-status[data-state="error"] { color: #FFAAA0; }

	@media (max-width: 1249px) {
		.contact-shell {
			max-width: 820px;
			grid-template-columns: 1fr;
			gap: 3rem;
		}
		.contact-copy h1 {
			max-width: 11ch;
			font-size: clamp(3.4rem, 7vw, 5.4rem);
		}
		.contact-form-wrap { max-width: 820px; }
	}
	@media (max-width: 600px) {
		.contact-page { padding-left: 1rem; padding-right: 1rem; }
		.contact-field-row { grid-template-columns: 1fr; }
		.contact-copy h1 { max-width: 10ch; font-size: clamp(3rem, 15vw, 4.6rem); }
		.contact-form-wrap { border-radius: 22px; padding: 1.25rem; }
		.contact-submit-row { align-items: flex-start; flex-direction: column; }
		.contact-direct a { grid-template-columns: 62px minmax(0, 1fr); }
		.contact-direct strong { font-size: .93rem; }
	}
</style>
