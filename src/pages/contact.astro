---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Contact | Lotus Technologies"
	description="Talk with Lotus Technologies about your technology, integration, software, or operational challenge."
>
	<section class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
		<div class="max-w-3xl">
			<p class="mb-4 text-sm font-semibold uppercase tracking-[0.22em] text-lotus-sky">
				Contact
			</p>

			<h1 class="text-5xl font-semibold tracking-tight text-white sm:text-6xl">
				What problem are you trying to solve?
			</h1>

			<p class="mt-6 text-lg leading-8 text-white/70">
				Our Contact page is coming soon.
			</p>
		</div>
	</section>
</BaseLayout>