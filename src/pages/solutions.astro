---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Solutions | Lotus Technologies"
	description="Technology solutions designed around real business problems."
>
	<section class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
		<div class="max-w-3xl">
			<p class="mb-4 text-sm font-semibold uppercase tracking-[0.22em] text-lotus-sky">
				Solutions
			</p>

			<h1 class="text-5xl font-semibold tracking-tight text-white sm:text-6xl">
				Technology built around the problem.
			</h1>

			<p class="mt-6 text-lg leading-8 text-white/70">
				Our Solutions page is coming soon.
			</p>
		</div>
	</section>
</BaseLayout>