---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Our Process | Lotus Technologies"
	description="See how Lotus Technologies works collaboratively with clients from discovery through launch and support."
>
	<section class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
		<div class="max-w-3xl">
			<p class="mb-4 text-sm font-semibold uppercase tracking-[0.22em] text-lotus-sky">
				Our Process
			</p>

			<h1 class="text-5xl font-semibold tracking-tight text-white sm:text-6xl">
				Two teams. One goal.
			</h1>

			<p class="mt-6 text-lg leading-8 text-white/70">
				Our Process page is coming soon.
			</p>
		</div>
	</section>
</BaseLayout>