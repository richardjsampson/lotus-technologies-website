---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Lotus Technologies"
	description="Lotus Technologies — technology solutions for real business problems."
>
	<section class="mx-auto flex min-h-screen max-w-7xl items-center px-6 py-24 lg:px-8">
		<div class="max-w-4xl">
			<h1 class="text-5xl font-semibold tracking-tight text-white sm:text-7xl">
				Solve business problems with technical solutions.
			</h1>

			<p class="mt-8 max-w-2xl text-lg leading-8 text-neutral-300 sm:text-xl">
				The new Lotus Technologies website is under construction.
			</p>

			<div class="mt-10">
				<a
					href="#"
					class="inline-flex rounded-lg bg-lotus-blue px-5 py-3 font-medium text-white transition hover:bg-lotus-sky"
				>
					Lotus Website v0.1
				</a>
			</div>
		</div>
	</section>
</BaseLayout>