---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Lotus Technologies"
	description="Lotus Technologies — technology solutions for real business problems."
>
	<section class="mx-auto grid min-h-[78vh] max-w-7xl items-center gap-14 px-6 py-24 lg:grid-cols-2 lg:px-8">
		<div class="max-w-3xl">
			<p class="mb-5 text-sm font-semibold uppercase tracking-[0.22em] text-lotus-sky">
				Lotus Technologies
			</p>

			<h1 class="text-5xl font-semibold tracking-tight text-white sm:text-7xl">
				Solve business problems with technical solutions.
			</h1>

			<p class="mt-8 max-w-2xl text-lg leading-8 text-white/70 sm:text-xl">
				We design, integrate, and implement technology that connects systems,
				streamlines operations, and helps businesses work better.
			</p>

			<div class="mt-10 flex flex-wrap gap-4">
				<a
					href="/contact"
					class="inline-flex rounded-lg bg-lotus-blue px-5 py-3 font-medium text-white transition hover:bg-lotus-sky"
				>
					Discuss Your Challenge
				</a>

				<a
					href="/case-studies"
					class="inline-flex rounded-lg border border-white/20 px-5 py-3 font-medium text-white transition hover:border-white/40 hover:bg-white/5"
				>
					See Our Work
				</a>
			</div>
		</div>

		<div class="relative">
			<div class="absolute inset-10 rounded-full bg-lotus-blue/20 blur-3xl"></div>

			<div class="relative rounded-3xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm">
				<div class="grid grid-cols-[1fr_auto_1fr] items-center gap-x-6 gap-y-6">

					<div class="rounded-2xl border border-white/10 bg-white/5 p-5">
						<p class="text-xs uppercase tracking-[0.18em] text-lotus-sky">
							Systems
						</p>
						<p class="mt-3 text-lg font-medium text-white">
							CRM + ERP
						</p>
					</div>

					<div></div>

					<div class="rounded-2xl border border-white/10 bg-white/5 p-5">
						<p class="text-xs uppercase tracking-[0.18em] text-lotus-sky">
							Commerce
						</p>
						<p class="mt-3 text-lg font-medium text-white">
							Payments + eCommerce
						</p>
					</div>

					<div class="flex items-center">
						<div class="h-px w-full bg-lotus-sky/30"></div>
					</div>

	<div class="relative flex h-44 w-44 items-center justify-center rounded-full border border-lotus-sky/50 bg-lotus-navy shadow-[0_0_60px_rgba(77,163,255,0.24)]">
						<div class="absolute inset-3 rounded-full bg-lotus-blue/10 blur-xl"></div>

						<img
							src="/lotus-mark.png"
							alt=""
							class="relative h-28 w-28 object-contain"
						/>
					</div>

					<div class="flex items-center">
						<div class="h-px w-full bg-lotus-sky/30"></div>
					</div>

					<div class="rounded-2xl border border-white/10 bg-white/5 p-6">
						<p class="text-xs uppercase tracking-[0.18em] text-lotus-sky">
							Applications
						</p>
						<p class="mt-3 text-lg font-medium text-white">
							Mobile + Web
						</p>
					</div>

					<div></div>

					<div class="rounded-2xl border border-white/10 bg-white/5 p-6">
						<p class="text-xs uppercase tracking-[0.18em] text-lotus-sky">
							Data
						</p>
						<p class="mt-3 text-lg font-medium text-white">
							APIs + Integration
						</p>
					</div>

				</div>

				<div class="mt-10 border-t border-white/10 pt-6">
					<p class="text-center text-xs font-semibold uppercase tracking-[0.22em] text-lotus-sky">
						Integration Hub
					</p>

					<p class="mt-2 text-center text-sm text-white/60">
						Connected systems. Coordinated workflows. One business outcome.
					</p>
				</div>
			</div>
		</div>
	</section>
	<section class="relative overflow-hidden bg-[#EAF1FA] text-lotus-navy">
		<div class="pointer-events-none absolute inset-x-0 top-0 h-20 bg-gradient-to-b from-lotus-navy to-transparent"></div>

<div class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-lotus-navy to-transparent"></div>
<div class="relative mx-auto max-w-7xl px-6 py-20 lg:px-8">
		<div class="text-center">
			<p class="text-sm font-semibold uppercase tracking-[0.22em] text-lotus-sky">
				Selected Experience
			</p>

			<h2 class="mt-3 text-2xl font-semibold tracking-tight text-lotus-navy/85">
				Experience supporting recognized organizations across technology, healthcare, mobility, and commerce.
			</h2>
		</div>

		<div class="mt-10 grid grid-cols-2 items-center gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-6">
			<div class="flex h-16 items-center justify-center">
				<img
					src="/clients/scripps.png"
					alt="Scripps Health"
					class="max-h-12 max-w-[150px] object-contain"
				/>
			</div>

			<div class="flex h-16 items-center justify-center">
				<img
					src="/clients/servicenow.png"
					alt="ServiceNow"
					class="max-h-12 max-w-[150px] object-contain"
				/>
			</div>

			<div class="flex h-16 items-center justify-center">
				<img
					src="/clients/kaiser.png"
					alt="Kaiser Permanente"
					class="max-h-12 max-w-[150px] object-contain"
				/>
			</div>

			<div class="flex h-16 items-center justify-center">
				<img
					src="/clients/taylormade.png"
					alt="TaylorMade"
					class="max-h-12 max-w-[150px] object-contain"
				/>
			</div>

			<div class="flex h-16 items-center justify-center">
				<img
					src="/clients/welk.png"
					alt="Welk"
					class="max-h-12 max-w-[150px] object-contain"
				/>
			</div>

			<div class="flex h-16 items-center justify-center">
				<img
					src="/clients/lytx.png"
					alt="Lytx"
					class="max-h-12 max-w-[150px] object-contain"
				/>
			</div>
		</div>
	</div>
</section>
<section class="relative overflow-hidden">
	<!-- Large decorative background form -->
	<div
		class="pointer-events-none absolute -right-48 top-24 h-[520px] w-[520px] rounded-full border border-lotus-blue/10"
	></div>
	<div
		class="pointer-events-none absolute -right-28 top-44 h-[360px] w-[360px] rounded-full border border-lotus-sky/10"
	></div>

	<div class="relative mx-auto max-w-7xl px-6 py-28 lg:px-8">
		<div class="grid gap-14 lg:grid-cols-[0..75fr_1.1fr]">

			<!-- Intro -->
			<div class="max-w-xl">
				<p class="text-sm font-semibold uppercase tracking-[0.22em] text-lotus-gold">
					Problems We Solve
				</p>

				<h2 class="mt-4 text-4xl font-semibold tracking-tight text-white sm:text-5xl">
					Technology should remove friction — not create it.
				</h2>

				<p class="mt-6 text-lg leading-8 text-white/65">
					We step in where software, systems, data, devices, and business
					process stop working together.
				</p>

				<div class="mt-10 h-px w-24 bg-gradient-to-r from-lotus-gold to-transparent"></div>
			</div>

			<!-- Visual problem clusters -->
			<div class="grid gap-6 md:grid-cols-2">

				<!-- Large card -->
				<div
					class="group relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-white/[0.07] to-white/[0.02] p-8 md:row-span-2"
				>
					<div
						class="absolute -right-16 -top-16 h-44 w-44 rounded-full bg-lotus-blue/10 blur-2xl transition group-hover:bg-lotus-blue/20"
					></div>

					<div
						class="flex h-14 w-14 items-center justify-center rounded-2xl border border-lotus-sky/20 bg-lotus-blue/10 text-lotus-sky"
					>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							class="h-7 w-7"
							aria-hidden="true"
						>
							<rect x="3" y="4" width="7" height="6" rx="1" />
							<rect x="14" y="14" width="7" height="6" rx="1" />
							<path d="M10 7h4a3 3 0 0 1 3 3v4" />
							<path d="M7 10v4a3 3 0 0 0 3 3h4" />
						</svg>
					</div>

					<p class="mt-10 text-sm font-semibold uppercase tracking-[0.18em] text-lotus-sky">
						Disconnected Technology
					</p>

					<h3 class="mt-3 text-3xl font-semibold tracking-tight text-white">
						Your systems work.<br />
						They just don’t work together.
					</h3>

					<p class="mt-5 leading-7 text-white/60">
						CRM, ERP, payments, eCommerce, SaaS, databases, and proprietary
						applications often become isolated islands of information.
					</p>

					<div class="mt-10 flex flex-wrap gap-2 text-xs text-white/45">
						<span class="rounded-full border border-white/10 px-3 py-1.5">CRM</span>
						<span class="rounded-full border border-white/10 px-3 py-1.5">ERP</span>
						<span class="rounded-full border border-white/10 px-3 py-1.5">APIs</span>
						<span class="rounded-full border border-white/10 px-3 py-1.5">Payments</span>
						<span class="rounded-full border border-white/10 px-3 py-1.5">Data</span>
					</div>
				</div>

				<!-- Workflow card -->
				<div
					class="group rounded-3xl border border-white/10 bg-white/[0.04] p-7 transition hover:border-lotus-gold/30 hover:bg-white/[0.06]"
				>
					<div class="flex items-start justify-between gap-6">
						<div>
							<p class="text-sm font-semibold uppercase tracking-[0.18em] text-lotus-gold">
								Process
							</p>

							<h3 class="mt-3 text-2xl font-semibold text-white">
								Too much work is still manual.
							</h3>
						</div>

						<div
							class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-lotus-gold/10 text-lotus-gold"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								class="h-6 w-6"
								aria-hidden="true"
							>
								<path d="M4 7h10" />
								<path d="M4 12h16" />
								<path d="M4 17h7" />
								<path d="M17 5l3 2-3 2" />
							</svg>
						</div>
					</div>

					<p class="mt-5 leading-7 text-white/60">
						Repetitive entry, spreadsheets, workarounds, and hand-offs create
						delay, inconsistency, and avoidable errors.
					</p>
				</div>

				<!-- Software fit card -->
				<div
					class="group rounded-3xl border border-white/10 bg-white/[0.04] p-7 transition hover:border-lotus-sky/30 hover:bg-white/[0.06]"
				>
					<div class="flex items-start justify-between gap-6">
						<div>
							<p class="text-sm font-semibold uppercase tracking-[0.18em] text-lotus-sky">
								Fit
							</p>

							<h3 class="mt-3 text-2xl font-semibold text-white">
								Your software almost does what you need.
							</h3>
						</div>

						<div
							class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-lotus-blue/10 text-lotus-sky"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								class="h-6 w-6"
								aria-hidden="true"
							>
								<path d="M8 3v4" />
								<path d="M16 3v4" />
								<path d="M5 7h14v13H5z" />
								<path d="M9 12h6" />
								<path d="M9 16h3" />
							</svg>
						</div>
					</div>

					<p class="mt-5 leading-7 text-white/60">
						We extend, integrate, or build around existing platforms instead
						of forcing your business into someone else’s workflow.
					</p>
				</div>

				<!-- Bottom-wide card -->
				<div
					class="group rounded-3xl border border-white/10 bg-gradient-to-r from-lotus-blue/10 via-white/[0.04] to-lotus-gold/5 p-7 md:col-span-2"
				>
					<div class="grid gap-6 sm:grid-cols-[auto_1fr] sm:items-center">
						<div
							class="flex h-14 w-14 items-center justify-center rounded-2xl border border-white/10 bg-lotus-navy/50 text-lotus-sky"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								class="h-7 w-7"
								aria-hidden="true"
							>
								<rect x="7" y="2" width="10" height="20" rx="2" />
								<path d="M10 5h4" />
								<path d="M10 18h4" />
								<path d="M3 9h4" />
								<path d="M17 14h4" />
							</svg>
						</div>

						<div>
							<p class="text-sm font-semibold uppercase tracking-[0.18em] text-lotus-sky">
								Connected Work
							</p>

							<h3 class="mt-2 text-2xl font-semibold text-white">
								People, devices, and data need to meet in the same workflow.
							</h3>

							<p class="mt-3 leading-7 text-white/60">
								Mobile devices, scanners, terminals, field teams, cloud services,
								and back-end systems should operate as one coordinated solution.
							</p>
						</div>
					</div>
				</div>

			</div>
		</div>
	</div>
</section>

<section class="border-y border-white/10 bg-white/[0.025]">
	<div class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
		<div class="grid gap-12 lg:grid-cols-[0.9fr_1.6fr] lg:items-start">
			<div class="max-w-xl">
				<p class="text-sm font-semibold uppercase tracking-[0.22em] text-lotus-sky">
					How We Help
				</p>

				<h2 class="mt-4 text-4xl font-semibold tracking-tight text-white sm:text-5xl">
					The right solution may involve one system — or several working together.
				</h2>

				<p class="mt-6 text-lg leading-8 text-white/65">
					We combine software, integration, devices, data, and cloud technology around the needs of the business rather than forcing every problem into the same technical approach.
				</p>

				<a
					href="/solutions"
					class="mt-8 inline-flex items-center gap-2 font-medium text-lotus-sky transition hover:text-white"
				>
					Explore all solutions
					<span aria-hidden="true">→</span>
				</a>
			</div>

			<div class="grid gap-6 md:grid-cols-2">
				<a
					href="/solutions"
					class="group rounded-2xl border border-white/10 bg-white/[0.04] p-7 transition hover:-translate-y-1 hover:border-lotus-sky/30 hover:bg-white/[0.06]"
				>
					<p class="text-sm font-semibold text-lotus-sky">
						01
					</p>

					<h3 class="mt-4 text-xl font-semibold text-white">
						Custom Software & Applications
					</h3>

					<p class="mt-3 leading-7 text-white/60">
						Design and build software around workflows, requirements, and operational challenges that off-the-shelf platforms cannot fully solve.
					</p>

					<p class="mt-6 text-sm font-medium text-white/50 transition group-hover:text-lotus-sky">
						Learn more →
					</p>
				</a>

				<a
					href="/solutions"
					class="group rounded-2xl border border-white/10 bg-white/[0.04] p-7 transition hover:-translate-y-1 hover:border-lotus-sky/30 hover:bg-white/[0.06]"
				>
					<p class="text-sm font-semibold text-lotus-sky">
						02
					</p>

					<h3 class="mt-4 text-xl font-semibold text-white">
						Systems & Data Integration
					</h3>

					<p class="mt-3 leading-7 text-white/60">
						Connect APIs, CRM, ERP, payments, eCommerce, databases, SaaS platforms, and proprietary systems into coordinated workflows.
					</p>

					<p class="mt-6 text-sm font-medium text-white/50 transition group-hover:text-lotus-sky">
						Learn more →
					</p>
				</a>

				<a
					href="/solutions"
					class="group rounded-2xl border border-white/10 bg-white/[0.04] p-7 transition hover:-translate-y-1 hover:border-lotus-sky/30 hover:bg-white/[0.06]"
				>
					<p class="text-sm font-semibold text-lotus-sky">
						03
					</p>

					<h3 class="mt-4 text-xl font-semibold text-white">
						Mobile & Connected Technology
					</h3>

					<p class="mt-3 leading-7 text-white/60">
						Build mobile and field solutions that connect users with scanners, terminals, payments, peripherals, and back-end systems.
					</p>

					<p class="mt-6 text-sm font-medium text-white/50 transition group-hover:text-lotus-sky">
						Learn more →
					</p>
				</a>

				<a
					href="/solutions"
					class="group rounded-2xl border border-white/10 bg-white/[0.04] p-7 transition hover:-translate-y-1 hover:border-lotus-sky/30 hover:bg-white/[0.06]"
				>
					<p class="text-sm font-semibold text-lotus-sky">
						04
					</p>

					<h3 class="mt-4 text-xl font-semibold text-white">
						Cloud & Technology Consulting
					</h3>

					<p class="mt-3 leading-7 text-white/60">
						Plan architecture, modernization, migration, infrastructure, and technology decisions around business requirements and long-term fit.
					</p>

					<p class="mt-6 text-sm font-medium text-white/50 transition group-hover:text-lotus-sky">
						Learn more →
					</p>
				</a>
			</div>
		</div>
	</div>
</section>
<section class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
	<div class="rounded-3xl border border-white/10 bg-white/[0.04] p-8 lg:p-12">
		<div class="grid gap-12 lg:grid-cols-[0.9fr_1.3fr] lg:items-center">
			<div>
				<p class="text-sm font-semibold uppercase tracking-[0.22em] text-lotus-sky">
					Featured Case Study
				</p>

				<h2 class="mt-4 text-4xl font-semibold tracking-tight text-white sm:text-5xl">
					From disconnected process to integrated workflow.
				</h2>

				<p class="mt-6 text-lg leading-8 text-white/65">
					We help clients identify where technology, process, and data are creating friction — then design a solution that connects the pieces.
				</p>

				<a
					href="/case-studies"
					class="mt-8 inline-flex items-center gap-2 font-medium text-lotus-sky transition hover:text-white"
				>
					View case studies
					<span aria-hidden="true">→</span>
				</a>
			</div>

			<div class="grid gap-5 sm:grid-cols-3">
				<div class="rounded-2xl border border-white/10 bg-lotus-navy/50 p-6">
					<p class="text-xs font-semibold uppercase tracking-[0.18em] text-lotus-sky">
						Challenge
					</p>
					<p class="mt-4 leading-7 text-white/70">
						Fragmented systems and manual steps created operational friction and avoidable errors.
					</p>
				</div>

				<div class="rounded-2xl border border-white/10 bg-lotus-navy/50 p-6">
					<p class="text-xs font-semibold uppercase tracking-[0.18em] text-lotus-sky">
						Solution
					</p>
					<p class="mt-4 leading-7 text-white/70">
						Lotus connected software, data, and workflow into a practical integrated solution.
					</p>
				</div>

				<div class="rounded-2xl border border-white/10 bg-lotus-navy/50 p-6">
					<p class="text-xs font-semibold uppercase tracking-[0.18em] text-lotus-sky">
						Outcome
					</p>
					<p class="mt-4 leading-7 text-white/70">
						A simpler process, better visibility, and technology that supported the business instead of slowing it down.
					</p>
				</div>
			</div>
		</div>
	</div>
</section>
<section class="border-y border-white/10 bg-white/[0.025]">
	<div class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
		<div class="grid gap-12 lg:grid-cols-[0.9fr_1.4fr] lg:items-center">
			<div>
				<p class="text-sm font-semibold uppercase tracking-[0.22em] text-lotus-sky">
					Our Process
				</p>

				<h2 class="mt-4 text-4xl font-semibold tracking-tight text-white sm:text-5xl">
					Two teams. One goal.
				</h2>

				<p class="mt-6 text-lg leading-8 text-white/65">
					Our clients are active participants throughout discovery, design, development,
					validation, and launch. Collaboration is built into the process rather than added at the end.
				</p>

				<a
					href="/our-process"
					class="mt-8 inline-flex items-center gap-2 font-medium text-lotus-sky transition hover:text-white"
				>
					See how we work
					<span aria-hidden="true">→</span>
				</a>
			</div>

			<div class="grid gap-4 sm:grid-cols-5">
				<div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5 text-center">
					<p class="text-xs font-semibold uppercase tracking-[0.18em] text-lotus-sky">
						01
					</p>
					<p class="mt-3 font-medium text-white">Discover</p>
				</div>

				<div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5 text-center">
					<p class="text-xs font-semibold uppercase tracking-[0.18em] text-lotus-sky">
						02
					</p>
					<p class="mt-3 font-medium text-white">Design</p>
				</div>

				<div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5 text-center">
					<p class="text-xs font-semibold uppercase tracking-[0.18em] text-lotus-sky">
						03
					</p>
					<p class="mt-3 font-medium text-white">Build</p>
				</div>

				<div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5 text-center">
					<p class="text-xs font-semibold uppercase tracking-[0.18em] text-lotus-sky">
						04
					</p>
					<p class="mt-3 font-medium text-white">Validate</p>
				</div>

				<div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5 text-center">
					<p class="text-xs font-semibold uppercase tracking-[0.18em] text-lotus-sky">
						05
					</p>
					<p class="mt-3 font-medium text-white">Launch</p>
