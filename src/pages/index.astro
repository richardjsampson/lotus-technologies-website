---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Lotus Technologies — technology solutions for real business problems."
		/>
		<title>Lotus Technologies</title>
	</head>

	<body class="min-h-screen bg-neutral-950 text-white">
		<main class="mx-auto flex min-h-screen max-w-7xl items-center px-6 py-24 lg:px-8">
			<section class="max-w-4xl">
				<p class="mb-5 text-sm font-semibold uppercase tracking-[0.25em] text-neutral-400">
					Lotus Technologies
				</p>

				<h1 class="text-5xl font-semibold tracking-tight sm:text-7xl">
					Solve business problems with technical solutions.
				</h1>

				<p class="mt-8 max-w-2xl text-lg leading-8 text-neutral-300 sm:text-xl">
					The new Lotus Technologies website is under construction.
				</p>

				<div class="mt-10">
					<a
						href="#"
						class="inline-flex rounded-lg bg-white px-5 py-3 font-medium text-neutral-950 transition hover:bg-neutral-200"
					>
						Lotus Website v0.1
					</a>
				</div>
			</section>
		</main>
	</body>
</html>