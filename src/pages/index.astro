---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Lotus Technologies"
	description="Lotus Technologies — technology solutions for real business problems."
>
	<section class="mx-auto grid min-h-[78vh] max-w-7xl items-center gap-14 px-6 py-24 lg:grid-cols-2 lg:px-8">
		<div class="max-w-3xl">
			<p class="mb-5 text-sm font-semibold uppercase tracking-[0.22em] text-lotus-sky">
				Lotus Technologies
			</p>

			<h1 class="text-5xl font-semibold tracking-tight text-white sm:text-7xl">
				Solve business problems with technical solutions.
			</h1>

			<p class="mt-8 max-w-2xl text-lg leading-8 text-white/70 sm:text-xl">
				We design, integrate, and implement technology that connects systems,
				streamlines operations, and helps businesses work better.
			</p>

			<div class="mt-10 flex flex-wrap gap-4">
				<a
					href="/contact"
					class="inline-flex rounded-lg bg-lotus-blue px-5 py-3 font-medium text-white transition hover:bg-lotus-sky"
				>
					Discuss Your Challenge
				</a>

				<a
					href="/case-studies"
					class="inline-flex rounded-lg border border-white/20 px-5 py-3 font-medium text-white transition hover:border-white/40 hover:bg-white/5"
				>
					See Our Work
				</a>
			</div>
		</div>

		<div class="relative">
			<div class="absolute inset-10 rounded-full bg-lotus-blue/20 blur-3xl"></div>

			<div class="relative rounded-3xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm">
				<div class="grid grid-cols-[1fr_auto_1fr] items-center gap-x-5 gap-y-5">

					<div class="rounded-2xl border border-white/10 bg-white/5 p-5">
						<p class="text-xs uppercase tracking-[0.18em] text-lotus-sky">
							Systems
						</p>
						<p class="mt-3 text-lg font-medium text-white">
							CRM + ERP
						</p>
					</div>

					<div></div>

					<div class="rounded-2xl border border-white/10 bg-white/5 p-5">
						<p class="text-xs uppercase tracking-[0.18em] text-lotus-sky">
							Commerce
						</p>
						<p class="mt-3 text-lg font-medium text-white">
							Payments + eCommerce
						</p>
					</div>

					<div class="flex items-center">
						<div class="h-px w-full bg-lotus-sky/30"></div>
					</div>

					<div class="relative flex h-24 w-24 items-center justify-center rounded-full border border-lotus-sky/30 bg-lotus-navy shadow-2xl">
						<img
							src="/lotus-mark.png"
							alt=""
							class="h-12 w-12 object-contain"
						/>
					</div>

					<div class="flex items-center">
						<div class="h-px w-full bg-lotus-sky/30"></div>
					</div>

					<div class="rounded-2xl border border-white/10 bg-white/5 p-5">
						<p class="text-xs uppercase tracking-[0.18em] text-lotus-sky">
							Applications
						</p>
						<p class="mt-3 text-lg font-medium text-white">
							Mobile + Web
						</p>
					</div>

					<div></div>

					<div class="rounded-2xl border border-white/10 bg-white/5 p-5">
						<p class="text-xs uppercase tracking-[0.18em] text-lotus-sky">
							Data
						</p>
						<p class="mt-3 text-lg font-medium text-white">
							APIs + Integration
						</p>
					</div>

				</div>

				<div class="mt-10 border-t border-white/10 pt-6">
					<p class="text-center text-xs font-semibold uppercase tracking-[0.22em] text-lotus-sky">
						Integration Hub
					</p>

					<p class="mt-2 text-center text-sm text-white/60">
						Connected systems. Coordinated workflows. One business outcome.
					</p>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>